{
  "manifest_version": 3,
  "name": "Claude mini: Browser",
  "version": "0.13.1",
  "minimum_chrome_version": "125",
  "description": "Рабочее место: язык, время, CPU, WebRTC, перенос настроек и экспорт. В составе самостоятельного portable-браузера.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "privacy",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude mini В· Browser",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "workspace.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "workspace.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://www.cloudflare.com"
  },
  "key": "",
  "host_permissions": [
    "https://www.cloudflare.com/*"
  ]
}